FROM nvidia/cuda:12.2.1-cudnn8-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y python3 python3-pip git && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY requirements.real.txt /work/requirements.real.txt
RUN python3 -m pip install --no-cache-dir -r requirements.real.txt
COPY . /work
EXPOSE 7860
CMD ["uvicorn", "worker_infer_enhanced:app", "--host", "0.0.0.0", "--port", "7860"]
